<launch>

  <arg name="raw_audio_topic" default="/audio" doc="Name of audio topic captured from respeaker." />
  <arg name="dummy_audio_topic" default="/dummy_audio" doc="Dummy audio. no Audio" />
  <arg name="audio_topic" default="/input_audio" doc="Selected audio topic" />
  <arg name="audio_info_topic" default="/audio_info" doc="Selected audio info topic" />  
  <arg name="language" default="ja-JP"/>
  <arg name="self_cancellation" default="false"/>
  <arg name="use_webrtcvad" default="false"
       doc="true: legacy webrtcvad_ros pipeline. false: ros_speech_recognition GoogleCloud continuous mode." />
  <arg name="google_cloud_credentials_json"
       default="/home/leus/config/eternal-byte-236613-4bc6962824d1.json" />

  <!-- speech recognition pipeline: respeaker + is_speaking + audio mux + STT
       (webrtcvad or GoogleCloudStream, switchable via use_webrtcvad) -->
  <include file="$(find jsk_2025_05_kashiwagi)/launch/speech_recognition.launch">
    <arg name="raw_audio_topic" value="$(arg raw_audio_topic)" />
    <arg name="dummy_audio_topic" value="$(arg dummy_audio_topic)" />
    <arg name="audio_topic" value="$(arg audio_topic)" />
    <arg name="audio_info_topic" value="$(arg audio_info_topic)" />
    <arg name="language" value="$(arg language)" />
    <arg name="self_cancellation" value="$(arg self_cancellation)" />
    <arg name="use_webrtcvad" value="$(arg use_webrtcvad)" />
    <arg name="webrtcvad_aggressiveness" value="1" />
    <arg name="google_cloud_credentials_json" value="$(arg google_cloud_credentials_json)" />
  </include>

  <node pkg="jsk_2025_05_kashiwagi" type="speech_test.py" name="speech_test" output="screen" />
  
</launch>
