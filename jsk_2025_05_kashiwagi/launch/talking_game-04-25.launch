<launch>

  <arg name="raw_audio_topic" default="/audio" doc="Name of audio topic captured from respeaker." />
  <arg name="dummy_audio_topic" default="/dummy_audio" doc="Dummy audio. no Audio" />
  <arg name="audio_topic" default="/input_audio" doc="Selected audio topic" />
  <arg name="audio_info_topic" default="/audio_info" doc="Selected audio info topic" />  
  <arg name="language" default="ja-JP"/>
  <arg name="self_cancellation" default="false"/>
  <arg name="use_webrtcvad" default="false"
       doc="true: legacy webrtcvad_ros pipeline. false: ros_speech_recognition GoogleCloud continuous mode." />

  <param name="robot_name" value="kashiwagi" />

  <!-- speech recognition pipeline: respeaker + is_speaking + audio mux + STT
       (webrtcvad or GoogleCloudStream, switchable via use_webrtcvad) -->
  <include file="$(find jsk_2025_05_kashiwagi)/launch/speech_recognition.launch">
    <arg name="raw_audio_topic" value="$(arg raw_audio_topic)" />
    <arg name="dummy_audio_topic" value="$(arg dummy_audio_topic)" />
    <arg name="audio_topic" value="$(arg audio_topic)" />
    <arg name="audio_info_topic" value="$(arg audio_info_topic)" />
    <arg name="language" value="$(arg language)" />
    <arg name="self_cancellation" value="$(arg self_cancellation)" />
    <arg name="use_webrtcvad" value="$(arg use_webrtcvad)" />
  </include>

  <!-- voicevox with docker -->
  <include file="$(find voicevox)/launch/voicevox_texttospeech.launch">
    <arg name="use_docker" value="true"/>
    <arg name="host" value="20.243.128.11"/>
    <!-- <arg name="device" value="plughw:2,0"/> -->
    <arg name="device" value="uac_demo"/>
  </include>

  <!-- RealSense RGBD camera -->
  <include file="$(find realsense2_camera)/launch/rs_rgbd.launch" />

  <!-- Hand Pose Estimation -->
  <include file="$(find semi2024)/launch/hand_pose_estimation_d405.launch" />
  
  <!-- <!-\- Hand Pose Estimation -\-> -->
  <!-- <include file="$(find semi2024)/launch/hand_pose_estimation_d405_light.launch" /> -->

  <!-- Gesture Recognition -->
  <include file="$(find semi2024)/launch/gesture_recognition.launch">
    <arg name="venv" value="/home/kashiwagi/ros/kashiwagi_ws/.venv/bin/python"/>
  </include>
  <!-- <!-\- Gesture Recognition -\-> -->
  <!-- <include file="$(find semi2024)/launch/gesture_recognition_light.launch"/> -->


  <!-- <!-\- respeaker -\-> -->
  <!-- <include file="$(find respeaker_ros)/launch/sample_respeaker.launch"> -->
  <!--   <arg name="language" value="ja-JP"/> -->
  <!-- </include> -->

  <!-- <!-\- voicevox with docker -\-> -->
  <!-- <include file="$(find voicevox)/launch/voicevox_texttospeech.launch"> -->
  <!--   <arg name="use_docker" value="true"/> -->
  <!--   <arg name="host" value="20.243.128.11"/> -->
  <!--   <!-\- <arg name="device" value="plughw:0,0"/> -\-> -->
  <!--   <arg name="device" value="uac_demo"/> -->
  <!-- </include> -->

  <!-- <node name="is_speaking" -->
  <!--       pkg="sound_play" type="is_speaking.py" > -->
  <!--   <remap from="~robotsound" to="/robotsound_jp/status" /> -->
  <!--   <remap from="~output/is_speaking" to="is_speaking" /> -->
  <!-- </node> -->


  <!-- QR code reader -->
  <node pkg="jsk_2025_05_kashiwagi" type="qr_code_reader.py" name="qr_code_reader" output="screen" />
  <!-- QR code depth reader -->
  <node pkg="jsk_2025_05_kashiwagi" type="qr_code_depth_reader.py" name="qr_code_depth_reader" output="screen" />
  
  <!-- response generator  -->
  <node pkg="jsk_2025_05_kashiwagi" type="response_generator-no-gpt.py" name="question_generator" output="screen" />

  <!-- response speaker -->
  <node pkg="jsk_2025_05_kashiwagi" type="response_speaker.py" name="response_speaker" output="screen" />

  <!-- state manager -->
  <node pkg="jsk_2025_05_kashiwagi" type="kashiwagi_state_manager.py" name="kashiwagi_state_manager" output="screen" />

  <!-- motion manager -->
  <node pkg="jsk_2025_05_kashiwagi" type="kashiwagi_motion_manager.py" name="kashiwagi_motion_manager" output="screen" />

  <!-- module manager -->
  <node pkg="jsk_2025_05_kashiwagi" type="kashiwagi_module_manager.py" name="kashiwagi_module_manager" output="screen" />
  
  <!-- look at direction  -->
  <node pkg="jsk_2025_05_kashiwagi" type="look_at_sound_direction.py" name="look_at_sound_direction" output="screen" />

  <!-- audio volume publisher  -->
  <node pkg="jsk_2025_05_kashiwagi" type="audio_volume_publisher.py" name="audio_volume_publisher" output="screen" />

  <!-- listener -->
  <node pkg="jsk_2025_05_kashiwagi" type="kashiwagi_listener.py" name="kashiwagi_listener" output="screen" />

  <!-- speaker -->
  <node pkg="jsk_2025_05_kashiwagi" type="kashiwagi_speaker.py" name="kashiwagi_speaker" output="screen" />

  <!-- time manager -->
  <node pkg="jsk_2025_05_kashiwagi" type="kashiwagi_time_manager.py" name="kashiwagi_time_manager" output="screen" />

  <!-- move and rotate manager -->
  <node pkg="jsk_2025_05_kashiwagi" type="kashiwagi_move_and_rotate_manager.py" name="kashiwagi_move_and_rotate_manager" output="screen" />

  <!-- nearest depth publisher -->
  <node pkg="jsk_2025_05_kashiwagi" type="nearest_depth_publisher.py" name="nearest_depth_publisher" output="screen" />

  <!-- katakana response generator -->
  <node pkg="jsk_2025_05_kashiwagi" type="katakanashi_response_generator.py" name="katakanashi_response_generator" output="screen" />

  <!-- kashiwagi state logger -->
  <node pkg="jsk_2025_05_kashiwagi" type="kashiwagi_state_logger.py" name="kashiwagi_state_logger" output="screen"/>

  <!-- shiritori response generator -->
  <node pkg="jsk_2025_05_kashiwagi" type="shiritori_response_generator.py" name="shiritori_response_generator" output="screen"/>

  <!-- shiritori word normalizer -->
  <node pkg="jsk_2025_05_kashiwagi" type="input_shiritori_word_normalizer.py" name="input_shiritori_word_normalizer" output="screen"/>

  <!-- time signal -->
  <node pkg="jsk_2025_05_kashiwagi" type="kashiwagi_time_signal.py" name="kashiwagi_time_signal" output="screen"/>

  <!-- free talk -->
  <node pkg="jsk_2025_05_kashiwagi" type="kashiwagi_free_talk.py" name="kashiwagi_free_talk" output="screen"/>

  <!-- speech filter -->
  <node pkg="jsk_2025_05_kashiwagi" type="speech_filter.py" name="speech_filter" output="screen"/>
  
</launch>
