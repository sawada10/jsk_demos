[
  { "id": 500, "text": "目から" },
  { "id": 501, "text": "きっと" },
  { "id": 502, "text": "きっと大丈夫" },
  { "id": 503, "text": "なのさ" },
  { "id": 504, "text": "超" },
  { "id": 505, "text": "幸せ" },
  { "id": 506, "text": "消すことのできない" },
  { "id": 507, "text": "幸せって" },
  { "id": 508, "text": "誰よりも" },
  { "id": 509, "text": "地獄" },
  { "id": 510, "text": "は確実に存在する" },
  { "id": 511, "text": "まるで" },
  { "id": 512, "text": "濡れた" },
  { "id": 513, "text": "おばさん" },
  { "id": 514, "text": "なんかより" },
  { "id": 515, "text": "の呪文かけてあげるよ" },
  { "id": 516, "text": "のこと教えてくれ" },
  { "id": 517, "text": "太陽" },
  { "id": 518, "text": "感じるんだ" },
  { "id": 519, "text": "触れると" },
  { "id": 520, "text": "夢" },
  { "id": 521, "text": "の魔法をかけられたんだ" },
  { "id": 522, "text": "のことで頭がいっぱいさ" },
  { "id": 523, "text": "鬼" },
  { "id": 524, "text": "同じ苗字" },
  { "id": 525, "text": "かもしれない" },
  { "id": 526, "text": "ロマンティック" },
  { "id": 527, "text": "フォーリンラブ" },
  { "id": 528, "text": "ぽっかり空いた" },
  { "id": 529, "text": "胸" },
  { "id": 530, "text": "まぶしい" },
  { "id": 531, "text": "はち切れそうさ" },
  { "id": 532, "text": "女神" },
  { "id": 533, "text": "ウエディング" },
  { "id": 534, "text": "消しさってあげるよ" },
  { "id": 535, "text": "暮らさないか？" },
  { "id": 536, "text": "犬" },
  { "id": 537, "text": "命よりも大切な" },
  { "id": 538, "text": "味噌汁" },
  { "id": 539, "text": "家" },
  { "id": 540, "text": "受け取ってほしい" },
  { "id": 541, "text": "鬼のように" },
  { "id": 542, "text": "になったとしても" },
  { "id": 543, "text": "お嫁" },
  { "id": 544, "text": "手を取り合って" },
  { "id": 545, "text": "猫" },
  { "id": 546, "text": "我慢できないんだ" },
  { "id": 547, "text": "中に" },
  { "id": 548, "text": "になりたいのさ" },
  { "id": 549, "text": "おばあちゃん" },
  { "id": 550, "text": "隣に" },
  { "id": 551, "text": "翼" },
  { "id": 552, "text": "離さない" },
  { "id": 553, "text": "天使" },
  { "id": 554, "text": "幸せにしてみせる" },
  { "id": 555, "text": "まったり" },
  { "id": 556, "text": "金" },
  { "id": 557, "text": "気持ち" },
  { "id": 558, "text": "みせてあげるよ" },
  { "id": 559, "text": "なんだね" },
  { "id": 560, "text": "のことを想うと" },
  { "id": 561, "text": "激しく" },
  { "id": 562, "text": "おじいちゃん" },
  { "id": 563, "text": "耐えられないんだ" },
  { "id": 564, "text": "笑いながら" },
  { "id": 565, "text": "にそっと触れてごらん" },
  { "id": 566, "text": "ベイビー" },
  { "id": 567, "text": "バラ色" },
  { "id": 568, "text": "本当の" },
  { "id": 569, "text": "って不思議だね" },
  { "id": 570, "text": "素敵" },
  { "id": 571, "text": "運命" },
  { "id": 572, "text": "結ばれる" },
  { "id": 573, "text": "ってなんだろう？" },
  { "id": 574, "text": "どんなに辛くても" },
  { "id": 575, "text": "大きくなって" },
  { "id": 576, "text": "作ってくれないか？" },
  { "id": 577, "text": "終わらない" },
  { "id": 578, "text": "希望" },
  { "id": 579, "text": "でしかない" },
  { "id": 580, "text": "記念日" },
  { "id": 581, "text": "無しでは考えられない" },
  { "id": 582, "text": "パートナー" },
  { "id": 583, "text": "強がりな" },
  { "id": 584, "text": "一瞬で" },
  { "id": 585, "text": "死ぬまで" },
  { "id": 586, "text": "キッス" },
  { "id": 587, "text": "なんて気にしなくていいのさ" },
  { "id": 588, "text": "苦しい時" },
  { "id": 589, "text": "神様がいるなら" },
  { "id": 590, "text": "これからもずっと" },
  { "id": 591, "text": "おしとやかな" },
  { "id": 592, "text": "バージンロード" },
  { "id": 593, "text": "変かな？" },
  { "id": 594, "text": "奇跡" },
  { "id": 595, "text": "どきどきする" },
  { "id": 596, "text": "一緒の墓に入ろう" },
  { "id": 597, "text": "なんちゃって" },
  { "id": 598, "text": "に変わる" },
  { "id": 599, "text": "永久に" },
  { "id": 600, "text": "聞いてくれ" },
  { "id": 601, "text": "ハッピー" },
  { "id": 602, "text": "幸せな" },
  { "id": 603, "text": "埋めてくれるかい？" },
  { "id": 604, "text": "一生一緒だよ" },
  { "id": 605, "text": "伝染病" },
  { "id": 606, "text": "みたいだね" },
  { "id": 607, "text": "悲しいとき" },
  { "id": 608, "text": "歩きながら" },
  { "id": 609, "text": "悲しみ" },
  { "id": 610, "text": "膨らんで" },
  { "id": 611, "text": "になってくれないか？" },
  { "id": 612, "text": "家族" },
  { "id": 613, "text": "いてほしい" },
  { "id": 614, "text": "一緒に" },
  { "id": 615, "text": "ナイト" },
  { "id": 616, "text": "になってあげるよ" },
  { "id": 617, "text": "尊い" },
  { "id": 618, "text": "ダメですか？" },
  { "id": 619, "text": "スーパー" },
  { "id": 620, "text": "誰も知らない" },
  { "id": 621, "text": "美しい" },
  { "id": 622, "text": "失いたくないんだ" },
  { "id": 623, "text": "この星" },
  { "id": 624, "text": "見てみたい" },
  { "id": 625, "text": "夢中さ" },
  { "id": 626, "text": "未来" },
  { "id": 627, "text": "そう思うだろ？" },
  { "id": 628, "text": "最高" },
  { "id": 629, "text": "こう言わせてくれ" },
  { "id": 630, "text": "見つめられるだけで" },
  { "id": 631, "text": "可愛い" },
  { "id": 632, "text": "穴" },
  { "id": 633, "text": "したいんだ" },
  { "id": 634, "text": "そろそろ" },
  { "id": 635, "text": "なんてクソくらえさ" },
  { "id": 636, "text": "ゴールイン" },
  { "id": 637, "text": "心から" },
  { "id": 638, "text": "昂ぶる" },
  { "id": 639, "text": "赤ちゃん" },
  { "id": 640, "text": "ぶち壊して" },
  { "id": 641, "text": "そんな世界" },
  { "id": 642, "text": "もう十分さ" },
  { "id": 643, "text": "愛" },
  { "id": 644, "text": "真っ白なキャンバス" },
  { "id": 645, "text": "マジ" },
  { "id": 646, "text": "この感情" },
  { "id": 647, "text": "世界一" },
  { "id": 648, "text": "叫んでる" },
  { "id": 649, "text": "求めるのさ" },
  { "id": 650, "text": "墓" },
  { "id": 651, "text": "あったかいだろ？" },
  { "id": 652, "text": "あの日見た" },
  { "id": 653, "text": "暗闇" },
  { "id": 654, "text": "しかない" },
  { "id": 655, "text": "宝石箱" },
  { "id": 656, "text": "抱きしめたい" },
  { "id": 657, "text": "じゃじゃ馬な" },
  { "id": 658, "text": "の雫" },
  { "id": 659, "text": "絶対に" },
  { "id": 660, "text": "どうにかなってしまいそうだ" },
  { "id": 661, "text": "手料理" },
  { "id": 662, "text": "守るよ" },
  { "id": 663, "text": "メロメロ" }
